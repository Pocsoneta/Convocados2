# -----------------------------------------------------------
# Convocados API — configuración de ejemplo
#
# Copiá este archivo como `.env` (que está en .gitignore) y
# completalo. Las variables que ya estén seteadas en el entorno
# tienen prioridad sobre el .env.
#
#   cp .env.example .env
# -----------------------------------------------------------

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=admin
DB_NAME=Convocados

# --- Servidor ---
HTTP_ADDR=:8080

# --- Sesión (JWT) ---
# Generá uno propio, por ejemplo con:
#   openssl rand -base64 32
JWT_SECRET=cambame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_HORAS=24

# --- Frontend ---
# Carpeta con el HTML/CSS/JS del front. Si está vacío, la API
# corre sola y no sirve archivos estáticos.
# FRONT_DIR=../Front

# --- Migraciones ---
# AUTO_MIGRATE=true
# MIGRATIONS_DIR=migrations

# --- Google Maps ---
# Clave de la API "Maps JavaScript API" + "Places API" para elegir la
# ubicación con autocompletado en Crear partido. Sin clave, el campo
# queda como ingreso manual de dirección.
# MAPS_API_KEY=

# --- CORS ---
# Solo si el front se sirve desde otro puerto (Live Server, etc.)
# ALLOW_ORIGIN=http://localhost:5500
